$(document).ready(function() {
  var passwordFields = ['#customer_password', '#passwd'];

  // Insert meter and suggestions
  $.each(passwordFields, function(i, selector) {
    var $field = $(selector);
    if ($field.length && $field.next('.password-meter-wrapper').length === 0) {
      $field.after(
        '<div class="password-meter-wrapper">' +
          '<div class="password-strength" style="margin-top:5px; font-weight:bold;"></div>' +
          '<div class="password-suggestions" style="font-size:12px; color:#888; margin-top:2px;"></div>' +
        '</div>'
      );
    }
  });

  function checkPasswordStrength(pwd) {
    var suggestions = [];
    var strength = 0;
    if (pwd.length >= 6) strength++; else suggestions.push("at least 6 characters");
    if (/[a-z]/.test(pwd)) strength++; else suggestions.push("a lowercase letter");
    if (/[A-Z]/.test(pwd)) strength++; else suggestions.push("an uppercase letter");
    if (/[0-9]/.test(pwd)) strength++; else suggestions.push("a number");
    if (/[^a-zA-Z0-9]/.test(pwd)) strength++; else suggestions.push("a special character");

    var strengthText = '';
    var color = '';
    if (!pwd) {
      strengthText = '';
      color = '';
    } else if (strength <= 3) {
      strengthText = 'Weak';
      color = 'red';
    } else if (strength === 4) {
      strengthText = 'Medium';
      color = 'orange';
    } else if (strength >= 5) {
      strengthText = 'Strong';
      color = 'green';
    }

    return {
      score: strength,
      isAcceptable: strength === 5, //Strong
      text: strengthText,
      color: color,
      suggestions: suggestions
    };
  }

  // Update strength/suggestions and button state on keyup
  $(document).on('keyup', passwordFields.join(','), function() {
    var $field = $(this);
    var val = $field.val();
        var $wrapper = $field.closest('.password-wrapper').next('.password-meter-wrapper');
    var result = checkPasswordStrength(val);

    $wrapper.find('.password-strength').text(result.text).css('color', result.color);
    if (!result.isAcceptable && val) {
      $wrapper.find('.password-suggestions').html("Add " + result.suggestions.join(', '));
    } else {
      $wrapper.find('.password-suggestions').html('');
    }

    // Disable/enable Next button (customer_password logic)
    if (result.score <= 4) {
      $('#next-step').prop('disabled', true);
    } else {
      $('#next-step').prop('disabled', false);
    }

    // ---------- ADD THIS BLOCK FOR account_btn and #passwd ----------
    // Only enable #account_btn if #passwd is strong
    var passwdVal = $('#passwd').val();
    var passwdStrength = checkPasswordStrength(passwdVal);
    if (passwdStrength.score === 5) {
      $('#account_btn').prop('disabled', false);
    } else {
      $('#account_btn').prop('disabled', true);
    }
    // ---------------------------------------------------------------
  });

  // Initial state: disable Next if password is empty or weak
  var initialPwdVal = $('#customer_password').val() || $('#passwd').val() || '';
  var initialResult = checkPasswordStrength(initialPwdVal);
  if (initialResult.score <= 4) {
    $('#next-step').prop('disabled', true);
  }

  // Initial state: disable account_btn if #passwd is not strong
  var initialPasswdVal = $('#passwd').val() || '';
  var initialPasswdResult = checkPasswordStrength(initialPasswdVal);
  if (initialPasswdResult.score === 5) {
    $('#account_btn').prop('disabled', false);
  } else {
    $('#account_btn').prop('disabled', true);
  }

  // Hide error on change
  $(document).on('input', passwordFields.join(','), function() {
    var $field = $(this);
    $field.closest('.form-group').find('.error-message').hide().text('');
    $field.closest('.form-group').removeClass('has-error');
  });
});
