<!-- Password toggle (works for buyer + seller) -->
<style>
/* wrapper */
.password-wrapper {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  border: 1px solid #e0e0e0;
  border-radius: 6px;
  overflow: hidden;
  background: #fff;
}

/* input inside wrapper */
.password-wrapper input {
  flex: 1;
  border: 0 !important;
  outline: 0 !important;
  padding: 10px 12px;
  background: transparent !important;
  box-shadow: none !important;
  min-height: 40px;
}

/* strength text if moved into wrapper */
.password-wrapper .password-strength {
  margin-left: 6px;
  font-weight: 700;
  color: #2fa84f; /* adjust to your theme */
  white-space: nowrap;
}

/* toggle button hidden until focus/value */
.password-wrapper .toggle-password {
  display: none;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  height: 100%;
  cursor: pointer;
  background: transparent;
  border: none;
}

/* show on focus OR when wrapper has value class */
.password-wrapper input:focus ~ .toggle-password,
.password-wrapper.has-value .toggle-password {
  display: flex;
}

.password-wrapper .toggle-password:hover { color: #026D8F; }

/* Chrome autofill fix (white background) */
input:-webkit-autofill,
input:-webkit-autofill:focus {
  -webkit-box-shadow: 0 0 0px 1000px #fff inset !important;
  box-shadow: 0 0 0px 1000px #fff inset !important;
  -webkit-text-fill-color: #000 !important;
}
button:focus {
    outline: none;
}
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const selectors = [
    '#customer_password', // buyer
    '#seller_password',   // seller
    'form#mp_register_form input[type="password"]',
    'form#customer-form input[type="password"]'
  ];

  const inputs = new Set();
  selectors.forEach(sel => {
    document.querySelectorAll(sel).forEach(el => inputs.add(el));
  });

  inputs.forEach(passwordInput => {
    if (!passwordInput) return;

    // skip if already inside a proper wrapper
    if (passwordInput.closest('.password-wrapper')) {
      const existingWrapper = passwordInput.closest('.password-wrapper');
      if (!existingWrapper.querySelector('.toggle-password')) {
        createToggle(existingWrapper, passwordInput);
      }
      return;
    }

    // create wrapper
    const wrapper = document.createElement('div');
    wrapper.className = 'password-wrapper';

    // insert wrapper before input and move input inside wrapper
    const parent = passwordInput.parentNode;
    parent.insertBefore(wrapper, passwordInput);
    wrapper.appendChild(passwordInput);

    // create the eye toggle
    createToggle(wrapper, passwordInput);

    // show/hide logic for wrapper based on input value (handles autofill)
    function refresh() {
      const has = !!(passwordInput.value && passwordInput.value.trim().length);
      wrapper.classList.toggle('has-value', has);
      if (!has && passwordInput.type === 'text') {
        passwordInput.type = 'password';
        const ic = wrapper.querySelector('.toggle-password i');
        if (ic) {
          ic.classList.remove('fa-eye-slash');
          ic.classList.add('fa-eye');
        }
      }
    }

    refresh();
    setTimeout(refresh, 50);
    setTimeout(refresh, 350);

    ['input','change','keyup','paste','cut']
      .forEach(ev => passwordInput.addEventListener(ev, refresh));
  });

  // helper: create eye toggle
  function createToggle(wrapper, passwordInput) {
    if (wrapper.querySelector('.toggle-password')) return;

    const eyeBtn = document.createElement('button');
    eyeBtn.type = 'button';
    eyeBtn.className = 'toggle-password';
    eyeBtn.setAttribute('aria-label','Show password');
    eyeBtn.innerHTML = '<i class="fa-solid fa-eye" aria-hidden="true"></i>';
    wrapper.appendChild(eyeBtn);

    eyeBtn.addEventListener('click', function (e) {
      e.preventDefault();
      const icon = eyeBtn.querySelector('i');
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        if (icon) {
          icon.classList.remove('fa-eye');
          icon.classList.add('fa-eye-slash');
        }
        eyeBtn.setAttribute('aria-label','Hide password');
      } else {
        passwordInput.type = 'password';
        if (icon) {
          icon.classList.remove('fa-eye-slash');
          icon.classList.add('fa-eye');
        }
        eyeBtn.setAttribute('aria-label','Show password');
      }
      passwordInput.focus();
    });
  }
});
</script>



