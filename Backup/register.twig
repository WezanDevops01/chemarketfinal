$(document).ready(function() {
  // Utility to show error message for a field
  function showError($field, message) {
    $field.closest('.form-group').addClass('has-error');
    $field.closest('.form-group').find('.error-message').text(message).show();
  }
  // Utility to hide error for a field
  function hideError($field) {
    $field.closest('.form-group').removeClass('has-error');
    $field.closest('.form-group').find('.error-message').hide().text('');
  }

  // Custom validators
  function isAlpha(val) {
    return /^[A-Za-z]+$/.test(val);
  }
  function isAlphaOrSpace(val) {
    return /^[A-Za-z\s]+$/.test(val);
  }
  function isValidEmail(val) {
    // Simple email regex; for stricter use RFC 5322 or a library
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
  }

  // Validate Step 1
  function validateStep1() {
    var valid = true;

    // Gender (radio group)
    if ($('input[name="id_gender"]:checked').length === 0) {
      $('#id_gender').addClass('has-error');
      if ($('#id_gender .error-message').length === 0) {
        $('#id_gender').append('<div class="error-message" style="color:red;display:block;"></div>');
      }
      $('#id_gender .error-message').text('Please select a title').show();
      valid = false;
    } else {
      $('#id_gender').removeClass('has-error');
      $('#id_gender .error-message').hide().text('');
    }

    // All other required fields in step 1
    $('#step-1').find('input,select,textarea').each(function() {
      var $field = $(this);

      // Skip radios, handled above
      if ($field.attr('type') === 'radio') return;

      // Privacy checkbox
      if ($field.attr('type') === 'checkbox' && $field.prop('required')) {
        if (!$field.prop('checked')) {
          showError($field, 'This box must be checked');
          valid = false;
        } else {
          hideError($field);
        }
        return;
      }

      // Normal required fields, including phone
      if ($field.prop('required') && !$field.val()) {
        showError($field, 'This field is required');
        valid = false;
      } else {
        hideError($field);
      }

      // ---- CUSTOM VALIDATION ----
      // First name - only alphabetic
      if ($field.attr('name') === 'firstname' && $field.val()) {
        if (!isAlpha($field.val())) {
          showError($field, 'First name must contain only letters');
          valid = false;
        }
      }
      // Last name - only alphabetic
      if ($field.attr('name') === 'lastname' && $field.val()) {
        if (!isAlpha($field.val())) {
          showError($field, 'Last name must contain only letters');
          valid = false;
        }
      }
      // Email - must match email format
      if ($field.attr('type') === 'email' && $field.val()) {
        if (!isValidEmail($field.val())) {
          showError($field, 'Please enter a valid email address');
          valid = false;
        }
      }
      // ---------------------------
    });

    return valid;
  }

  // Validate Step 2 (all required fields, including selects)
  function validateStep2() {
    var valid = true;
    $('#step-2').find('input,select,textarea').each(function() {
      var $field = $(this);

      // Normal required fields (skip hidden fields)
      if ($field.prop('required') && $field.is(':visible') && !$field.val()) {
        showError($field, 'This field is required');
        valid = false;
      } else {
        hideError($field);
      }

      // ---- CUSTOM VALIDATION ----
      // City - only alphabetic and spaces
      if ($field.attr('name') === 'city' && $field.val()) {
        if (!isAlphaOrSpace($field.val())) {
          showError($field, 'City must contain only letters');
          valid = false;
        }
      }
      // ---------------------------
    });
    return valid;
  }

  // Next button logic
  $('#next-step').click(function() {
    if (validateStep1()) {
      $('#step-1').hide();
      $('#step-2').show();
      $('#prev-step').hide();
      $('html,body').animate({ scrollTop: $('#step-2').offset().top }, 'fast');
    }
  });

  // Back button logic (on both steps)
  $('#prev-step, #prev-step2').click(function() {
    $('#step-2').hide();
    $('#step-1').show();
    $('#prev-step').hide(); // Hide back on step 1
    $('html,body').animate({ scrollTop: $('#step-1').offset().top }, 'fast');
  });

  // Show back button only on step 2 (optional, depends on your UX)
  $('#customer-form').on('showStep2', function() {
    $('#prev-step').show();
  });

  $(document).on('showStep2', function() {
    $('#prev-step').show();
  });

  // Validate both steps before submit
  $('#customer-form').on('submit', function(e) {
    var valid1 = validateStep1();
    var valid2 = validateStep2();
    if (!(valid1 && valid2)) {
      // Show step 1 if that's the problem, otherwise step 2
      if (!valid1) {
        $('#step-2').hide();
        $('#step-1').show();
        $('#prev-step').hide();
      } else if (!valid2) {
        $('#step-1').hide();
        $('#step-2').show();
        $('#prev-step').show();
      }
      e.preventDefault();
      return false;
    }
    return true;
  });

  // Remove error class on input/select/textarea change
  $('#customer-form').on('change keyup', 'input,select,textarea', function() {
    var $field = $(this);
    hideError($field);

    // Special for gender radios
    if ($field.attr('type') === 'radio' && $field.attr('name') === 'id_gender') {
      if ($('input[name="id_gender"]:checked').length) {
        $('#id_gender').removeClass('has-error');
        $('#id_gender .error-message').hide().text('');
      }
    }
    // Special for privacy checkbox
    if ($field.attr('type') === 'checkbox' && $field.attr('name') === 'customer_privacy') {
      if ($field.prop('checked')) {
        hideError($field);
      }
    }
  });
});

document.addEventListener("DOMContentLoaded", function () {
  const phoneInput = document.querySelector("#mp_seller_phone");
  const countryCodeInput = document.querySelector("#country_code");

  if (phoneInput) {
    const iti = window.intlTelInput(phoneInput, {
      utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/utils.js",
    });

    function updateCountryCode() {
      const countryData = iti.getSelectedCountryData();
      if (countryData && countryCodeInput) {
        countryCodeInput.value = countryData.dialCode || "";
      }
    }

    // Set initial value on load
    updateCountryCode();

    // Update on country change
    phoneInput.addEventListener("countrychange", updateCountryCode);
  }
});
</script>
