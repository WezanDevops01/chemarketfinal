document.addEventListener("DOMContentLoaded", function () {
  const phoneFields = ["#mp_seller_phone_buyer", "#mp_seller_phone"];
  const countryCodeInput = document.querySelector('input[name="country_code"]');

  // Map country ISO code (uppercase) to max length
  const countryLengths = {
    IN: 10, // India
    SA: 9,  // Saudi Arabia
    AE: 9,  // UAE
    BH: 8,  // Bahrain
    KW: 8,  // Kuwait
    OM: 8,  // Oman
    QA: 8,  // Qatar
    BD: 10, // Bangladesh
    PK: 10, // Pakistan
    AF: 9   // Afghanistan
  };

  phoneFields.forEach(function (selector) {
    const input = document.querySelector(selector);
    if (input) {
      // Save initial maxlength (if any)
      const defaultMaxLength = input.getAttribute("maxlength") || "15";

      const iti = window.intlTelInput(input, {
        utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/utils.js",
      });

      function setDialCodeHiddenField() {
        const countryData = iti.getSelectedCountryData();
        if (countryCodeInput) {
          countryCodeInput.value = countryData.dialCode ? countryData.dialCode : "";
        }
      }

      function updateMaxLength() {
        const countryData = iti.getSelectedCountryData();
        const iso = countryData.iso2 ? countryData.iso2.toUpperCase() : "";
        
        let maxLen = countryLengths.hasOwnProperty(iso) ? countryLengths[iso] : 15;
        let minLen = countryLengths.hasOwnProperty(iso) ? countryLengths[iso] : 10;

        input.setAttribute("maxlength", maxLen);
        input.setAttribute("minlength", minLen); // HTML5 validation
      }

      // Trigger updates on load
      input.addEventListener("load", function () {
        setDialCodeHiddenField();
        updateMaxLength();
      });
      input.dispatchEvent(new Event("load"));

      // On country change
      input.addEventListener("countrychange", function () {
        setDialCodeHiddenField();
        updateMaxLength();
      });
    }
  });
});


